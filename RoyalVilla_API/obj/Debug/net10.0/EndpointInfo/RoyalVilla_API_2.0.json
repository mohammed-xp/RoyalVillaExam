              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOfUserDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOfUserDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOfUserDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
